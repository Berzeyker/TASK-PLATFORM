# PostgreSQL (Neon en la nube o Postgres local).
# - Neon: usa la cadena "pooled" en DATABASE_URL y la "direct" en DIRECT_URL.
# - Local: ambas pueden ser la misma cadena.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/task?schema=public

# Secreto para firmar los JWT (cambiar en producción).
JWT_SECRET=cambia_este_secreto_de_desarrollo

# Origen permitido para CORS (el dashboard en desarrollo).
CORS_ORIGIN=http://localhost:5173

PORT=3000
UPLOAD_DIR=uploads

# URL del microservicio de IA (FastAPI).
AI_SERVICE_URL=http://localhost:8001
