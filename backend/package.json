{
  "name": "task-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:offline": "vitest run --config vitest.offline.config.ts",
    "test:watch": "vitest --config vitest.offline.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.2"
  }
}
